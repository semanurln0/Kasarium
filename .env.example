# Example environment variables for Kasarium
# Copy this file to .env and fill in real values

SECRET_KEY=replace-me-with-a-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (use sqlite for dev or a postgres URL in prod)
# For sqlite: leave DATABASE_URL blank and the project will use default sqlite
DATABASE_URL=

# Store settings
STORE_NAME=Kasarium
STORE_ADDRESS=Your%20Store%20Address
STORE_PHONE=+37000000000
STORE_VAT_ID=

# Other
DEFAULT_REFUND_DAYS=7
# Copy to .env and fill in values
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (required for all environments)
DB_NAME=kasarium
DB_USER=postgres
DB_PASSWORD=3372
DB_HOST=localhost
DB_PORT=5432

# Or for Render.com production
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
